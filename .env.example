# Copy to .env and fill in real values, then: cp .env.example .env

# --- Supabase (auth + Postgres + pgvector) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# The ANON / PUBLISHABLE key, never the service_role or sb_secret_ one:
# /api/v1/public-config serves this value to unauthenticated callers because the
# frontend needs it. A service key there bypasses every row-level security
# policy you have. The API refuses to start if it detects one.
SUPABASE_KEY=<supabase-anon-or-publishable-key>
# DATABASE_URL powers both structured queries AND pgvector semantic search.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Secrets ---
# Fernet key encrypting users' stored LLM API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=<fernet-key>

# --- CORS ---
# Comma-separated browser origins allowed to call the API. Leave unset for local
# development (localhost dev servers are allowed automatically). The mobile app
# does not use CORS, and the packaged web build is served same-origin by this
# process, so in production this is usually empty or one marketing domain.
# "*" works but must be set deliberately — it is logged as a warning on boot.
# ALLOWED_ORIGINS=https://app.example.com
