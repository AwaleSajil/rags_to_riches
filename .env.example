# Copy to .env and fill in real values, then: cp .env.example .env

# --- Supabase (auth + Postgres + pgvector) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# The ANON / PUBLISHABLE key, never the service_role or sb_secret_ one:
# /api/v1/public-config serves this value to unauthenticated callers because the
# frontend needs it. A service key there bypasses every row-level security
# policy you have. The API refuses to start if it detects one.
SUPABASE_KEY=<supabase-anon-or-publishable-key>
# DATABASE_URL powers both structured queries AND pgvector semantic search.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Secrets ---
# Fernet key encrypting users' stored LLM API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=<fernet-key>

# --- CORS ---
# Comma-separated browser origins allowed to call the API. Leave unset for local
# development (localhost dev servers are allowed automatically). The mobile app
# does not use CORS, and the packaged web build is served same-origin by this
# process, so in production this is usually empty or one marketing domain.
# "*" works but must be set deliberately — it is logged as a warning on boot.
# ALLOWED_ORIGINS=https://app.example.com

# --- Account deletion (required by both app stores) -------------------------
# The Supabase SERVICE ROLE key (Project Settings -> API -> service_role).
# Deleting a user's auth record is the only thing this is used for, and the
# anon key above cannot do it. It BYPASSES row-level security, so it must never
# be sent to a client — /public-config serves SUPABASE_KEY only, and there is a
# test holding that line.
# Without it the app boots, but "Delete my account" answers 503. Both stores
# require a working in-app delete, so set it before submitting a build.
SUPABASE_SERVICE_KEY=

# Shown on the public /account-deletion, /privacy and /terms pages as the
# contact address. Play requires the deletion page to be reachable without the
# app, and both stores require a resolving privacy policy URL.
SUPPORT_EMAIL=

# The party named as responsible for user data in the privacy policy — your name
# or your company's. Left blank it renders as a visible "[not configured]"
# marker rather than a guess: naming the wrong entity in a published policy is
# worse than an obviously incomplete one.
PUBLISHER_NAME=
